#!/bin/zsh
# Offline document conversion; this program never opens a printer.
set -euo pipefail
DRIVER_DIR="${0:A:h}"
export PATH="$DRIVER_DIR:/usr/bin:/bin:/usr/sbin:/sbin"
export GSBIN="$DRIVER_DIR/gs"
unset GS_LIB GS_OPTIONS GS_FONTPATH DYLD_LIBRARY_PATH DYLD_INSERT_LIBRARIES

[[ $# == 4 ]] || { print -u2 'Usage: hp1020-convert INPUT OUTPUT a4|letter COPIES'; exit 2; }
input="$1"
output="$2"
case "$3" in
  a4) paper=9 ;;
  letter) paper=1 ;;
  *) print -u2 'Unsupported paper size'; exit 2 ;;
esac
[[ "$4" == <1-999> && -f "$input" ]] || exit 2
umask 077
"$DRIVER_DIR/foo2zjs-wrapper" -P -z1 -L0 -p"$paper" -n"$4" "$input" > "$output"
[[ -s "$output" ]] || { print -u2 'Document conversion produced no data'; exit 1; }
