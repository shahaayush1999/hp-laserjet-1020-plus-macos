<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.aayush.hp1020-root-spool-worker</string>
  <key>ProgramArguments</key><array><string>/Library/Printers/hp1020/hp1020-root-spool-worker</string></array>
  <key>QueueDirectories</key><array><string>/private/var/spool/cups/tmp/hp1020queue/ready</string></array>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/Library/Printers/hp1020/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Library/Printers/hp1020/launchd.err.log</string>
</dict></plist>
