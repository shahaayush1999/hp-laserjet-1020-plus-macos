#!/bin/zsh
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
fail() { print -u2 "HP 1020 installer: $*"; exit 1; }
[[ "$3" == / ]] || fail 'Install on the running Mac, not another disk.'
[[ $(id -u) == 0 && $(uname -m) == arm64 ]] || fail 'An Apple Silicon Mac and administrator permission are required.'
[[ -x /usr/libexec/cups/backend/usb ]] || fail 'This macOS installation has no CUPS USB backend.'
BASE=/Library/Printers/hp1020
QUEUE=/private/var/spool/cups/tmp/hp1020queue
if [[ -e "$BASE" && ! -f "$BASE/package-version" ]]; then
  fail 'An older manual HP 1020 setup is installed. Keep using it; this package is for a fresh Mac.'
fi
for checked_path in "$BASE" "$QUEUE" /usr/libexec/cups/backend/hp1020queue /usr/libexec/cups/filter/hp1020passthrough; do
  [[ ! -L "$checked_path" ]] || fail "Unexpected symbolic link at $checked_path"
done
if [[ ! -f "$BASE/package-version" ]]; then
  [[ ! -e "$QUEUE" && ! -e /usr/libexec/cups/backend/hp1020queue && ! -e /usr/libexec/cups/filter/hp1020passthrough ]] || fail 'Existing HP 1020 files need inspection before installation.'
  if lpstat -p HP_LaserJet_1020_Plus >/dev/null 2>&1; then
    fail 'A printer with this queue name already exists. No changes were made.'
  fi
else
  setopt NULL_GLOB
  jobs=("$QUEUE/incoming"/* "$QUEUE/ready"/* "$QUEUE/processing"/*)
  (( ${#jobs} == 0 )) || fail 'Finish pending jobs before updating this package.'
  [[ -z "$(lpstat -o HP_LaserJet_1020_Plus 2>/dev/null)" ]] || fail 'Finish queued jobs before updating.'
  launchctl bootout system /Library/LaunchDaemons/com.aayush.hp1020-root-spool-worker.plist 2>/dev/null || true
fi
