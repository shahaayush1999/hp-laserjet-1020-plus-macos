#!/bin/zsh
# Compatibility command: submit through the same CUPS path used by the print dialog.
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
printer=@@PRINTER_NAME_SHELL@@
paper=A4
copies=1
while (( $# )); do
  case "$1" in
    -p) (( $# >= 2 )) || exit 2; paper="$2"; shift 2 ;;
    -n) (( $# >= 2 )) || exit 2; copies="$2"; shift 2 ;;
    --) shift; break ;;
    -*) print -u2 -- 'Usage: hp1020-print [-p a4|letter] [-n COPIES] FILE'; exit 2 ;;
    *) break ;;
  esac
done
(( $# == 1 )) && [[ "$copies" == <1-9999> && -f "$1" ]] || exit 2
case "$paper" in a4|A4) paper=A4 ;; letter|Letter) paper=Letter ;; *) exit 2 ;; esac
exec lp -d "$printer" -n "$copies" -o "PageSize=$paper" -o Collate=True -- "$1"
