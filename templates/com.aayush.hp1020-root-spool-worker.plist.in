<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@@LABEL@@</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Printers/hp1020/hp1020-root-spool-worker</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>/private/var/spool/cups/tmp/hp1020queue</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Library/Printers/hp1020/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Printers/hp1020/launchd.err.log</string>
</dict>
</plist>
